            cand -C 'C'
            cand --yes 'yes'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'ego;rules;explain'= {
            cand --profile 'profile'
            cand -C 'C'
            cand --json 'json'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'ego;mcp-server'= {
            cand --session-dir 'Override the store location'
            cand -C 'Run as if started in DIR'
            cand --max-concurrent-runs 'Runs that may execute at once'
            cand --retained-requests 'Finished requests kept for status and resource reads'
            cand --max-resource-bytes 'Largest resource body returned to a client, in bytes'
            cand --allow-root 'Also let clients run in DIR. The directory given with -C (or the current one) is always allowed'
            cand --allow-model 'Also let clients select this model. The configured model is always allowed'
            cand --allow-mode 'Also let clients select this mode. The configured mode is always allowed'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'ego;worktree'= {
            cand -h 'Print help'
            cand --help 'Print help'
            cand show 'Inspect a durable local worktree receipt without starting a model'
            cand cleanup 'Remove only a clean worktree whose commits are integrated; retain its branch'
        }
        &'ego;worktree;show'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'ego;worktree;cleanup'= {
            cand -h 'Print help'
            cand --help 'Print help'
        }
    ]
    $completions[$command]
}
