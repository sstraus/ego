            cand --session 'Named session: created or attached'
            cand --session-id 'A session id supplied by the caller'
            cand --worktree 'Create a retained managed worktree on this explicitly approved new branch'
            cand --accept-authority-delta 'Accept the authority change shown for this resume, without a question. Applies to this resume only'
            cand --queue 'Wait while another process owns the session, then run the prompt headless. Waiting counts toward --timeout'
            cand --offline 'No non-loopback egress from ego''s own HTTP transport'
            cand --bare 'No ambient discovery, even in a trusted workspace'
            cand --no-tools 'Offer no tools at all'
            cand --no-hooks 'Run with every hook off for this invocation; configuration is unchanged'
            cand --trust-workspace 'Trust this launch''s workspace without asking; remember the answer'
            cand --trust-development-programs 'Trust this workspace and future edits to its current named programs; remember the grant'
