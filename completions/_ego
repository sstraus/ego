(( $+functions[_ego_commands] )) ||
_ego_commands() {
    local commands; commands=(
'run:Run an agent from a prompt, headless.' \
'resume:Continue a session; no ID = latest in this workspace.' \
'fork:Fork a session at its latest durable idle boundary.' \
'compact:Compact a session into its deterministic successor.' \
'export:Export a session locally or as a structurally sanitized bundle.' \
'ls:List sessions (this workspace; --all for every one).' \
'usage:Report usage, context and cost for this workspace.' \
'models:List the shared model catalogue.' \
'hooks:Inspect the admitted system and user hook catalogue.' \
'doctor:Report a read-only redacted health snapshot of this installation.' \
'acp:Serve the Agent Client Protocol on stdio or an endpoint.' \
'a2a:Serve the Agent2Agent protocol on a local or loopback endpoint.' \
'auth:Manage subscription credentials.' \
'mcp:Manage configured MCP servers.' \
'config:Manage stored user configuration.' \
'rules:Inspect and manage persistent permission rules.' \
'mcp-server:Serve scoped ego runs over MCP on stdio.' \
    )
    _describe -t commands 'ego commands' commands "$@"
}
