{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ego:sandbox-auto:v2:verdict",
  "title": "Residual write advisory verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant",
    "path",
    "scope",
    "reason"
  ],
  "properties": {
    "grant": {
      "enum": [
        "none",
        "write"
      ]
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "enum": [
        "none",
        "session",
        "always"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "grant": {
            "const": "none"
          }
        }
      },
      "then": {
        "properties": {
          "path": {
            "type": "null"
          },
          "scope": {
            "const": "none"
          }
        }
      },
      "else": {
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "scope": {
            "enum": [
              "session",
              "always"
            ]
          }
        }
      }
    }
  ]
}
